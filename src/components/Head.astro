---
import site from "../data/site.json";
import { fromSiteRoot } from "../lib/relative-paths.ts";
import faviconAsset from "../assets/favicon.png";
import backgroundAp from "../assets/background/background_ap.jpg";
import backgroundSp from "../assets/background/background_sp.jpg";

type Props = {
  pageTitle?: string;
  description?: string;
  pageType?: "website" | "article";
  publishedAt?: string | Date;
};

const {
  pageTitle,
  description = site.description,
  pageType = "website",
  publishedAt,
} = Astro.props as Props;

const title = pageTitle ?? site.title;
const pagePath = Astro.url.pathname;
const canonicalBase = Astro.site ?? site.url;
const canonicalUrl = new URL(Astro.url.pathname, canonicalBase).toString();
const faviconHref = fromSiteRoot(pagePath, faviconAsset.src);
const ogImageUrl = new URL(
  "/og/openastronomy-og.jpg",
  canonicalBase,
).toString();
const ogImageWidth = 1200;
const ogImageHeight = 630;

// Pick one background per page (stable per URL length, no FOUC).
const backgroundOptions = [backgroundAp, backgroundSp];
const backgroundAsset =
  backgroundOptions[pagePath.length % backgroundOptions.length];
const backgroundHref = fromSiteRoot(pagePath, backgroundAsset.src);

const publishedIso =
  publishedAt instanceof Date
    ? publishedAt.toISOString()
    : (publishedAt ?? undefined);
---

<head>
  <title>{title}</title>
  <link rel="icon" type="image/png" href={faviconHref} />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="OpenAstronomy" />
  <meta property="og:type" content={pageType} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="OpenAstronomy" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:secure_url" content={ogImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:image:alt" content="OpenAstronomy logo" />
  {
    pageType === "article" && publishedIso ? (
      <meta property="article:published_time" content={publishedIso} />
    ) : null
  }
  <link rel="canonical" href={canonicalUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    rel="stylesheet"
  />

  <style set:html={`:root{--page-bg:url("${backgroundHref}")}`}></style>
</head>
