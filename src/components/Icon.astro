---
/*
 * The hamburger entry in icons.json has `paths` (an array) instead of `d`
 * and is rendered inline by Header.astro directly, not via this component.
 */
import icons from "../data/icons.json";

type IconEntry = { d?: string; viewBox: string; paths?: string[] };

type Props = {
  name: string;
  size?: number;
  fill?: string;
};
const { name, size = 16, fill = "currentColor" } = Astro.props as Props;
const icon = (icons as unknown as Record<string, IconEntry>)[name];
if (!icon?.d) {
  throw new Error(`Unknown icon: ${name}`);
}
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox={icon.viewBox}
  aria-hidden="true"
  focusable="false"
>
  <path fill={fill} d={icon.d}></path>
</svg>
