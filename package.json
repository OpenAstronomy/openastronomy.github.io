{
  "name": "openastronomy-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"src/**/*.{astro,js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{astro,js,ts}\" --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "astro:check": "astro check",
    "check": "npm run lint && npm run astro:check",
    "linkcheck": "lychee --no-progress --root-dir \"$PWD/html\" --remap \"^https://openastronomy\\.org/(.*)$ file://$(pwd | sed 's/ /%20/g')/html/\\$1\" html"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
